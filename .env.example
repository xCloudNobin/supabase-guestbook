# Base URL of the Supabase REST API (e.g. https://your-project.supabase.co
# or http://api:8000 inside the bundled Compose stack).
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key for the project.
SUPABASE_ANON_KEY=your-anon-key

# Compose-only: tells the client to strip the authorization header when the
# stack uses an internal PostgREST role instead of JWT auth. Not needed for a
# hosted Supabase project.
# SUPABASE_INTERNAL_NO_AUTH=true
